@page "/Reg"
@page "/"
@using Messanger.Shared.Module
@using Client.Services
@inject AuthStorageService AuthStorage
@inject NavigationManager Nav
@inject HttpClient Http

<div class="auth-container">
    <div class="auth-card">
        <div class="brand-logo">💬</div>
        <h1 class="brand-title">Messenger BETA</h1>
        <p class="subtitle">@(isLoginMode ? "Вход в аккаунт" : "Создание нового профиля")</p>

        <!-- Переключатель Вход / Регистрация -->
        <div class="auth-tabs">
            <button class="auth-tab @(isLoginMode ? "active" : "")" @onclick="() => SetMode(true)">Вход</button>
            <button class="auth-tab @(!isLoginMode ? "active" : "")" @onclick="() => SetMode(false)">Регистрация</button>
        </div>

        <!-- Поле: Email / Почта -->
        <div class="input-group">
            <label>Электронная почта</label>
            <input type="email" 
                   @bind="email" 
                   @bind:event="oninput" 
                   placeholder="user@example.com"
                   minlength="5"
                   maxlength="255" 
                   @onkeyup="HandleKeyUp" />
        </div>

        <!-- Поля: Юзер и Имя (только при регистрации) -->
        @if (!isLoginMode)
        {
            <div class="input-group">
                <label>Юзернейм (@username)</label>
                <input type="text" 
                       @bind="username" 
                       @bind:event="oninput" 
                       placeholder="ivan_ivanov" 
                       maxlength="20"
                       minlength="4"
                       @onkeyup="HandleKeyUp" />
            </div>

            <div class="input-group">
                <label>Отображаемое имя</label>
                <input type="text" 
                       @bind="name" 
                       @bind:event="oninput" 
                       placeholder="Вася Пупкин" 
                       maxlength="20"
                       @onkeyup="HandleKeyUp" />
            </div>
        }

        <!-- Поле: Пароль -->
        <div class="input-group">
            <label>Пароль</label>
            <div class="password-wrapper">
                <input type="@(showPassword ? "text" : "password")" 
                       @bind="password" 
                       @bind:event="oninput" 
                       placeholder="••••••••" 
                       @onkeyup="HandleKeyUp" 
                       minlength="6"
                       maxlength="20"/>
                <button type="button" class="btn-toggle-pwd" @onclick="() => showPassword = !showPassword">
                    @(showPassword ? "👁️" : "🔒")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }

        <button class="btn-primary" @onclick="HandleSubmit" disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <span>Подключение к серверу...</span>
            }
            else
            {
                <span>@(isLoginMode ? "Войти в чат" : "Зарегистрироваться")</span>
            }
        </button>
    </div>
</div>

@code {
    private static readonly Random random = new Random();
    private string email = "";
    private string username = "";
    private string name = "";
    private string password = "";
    private string errorMessage = "";
    private bool isSubmitting = false;
    private bool isLoginMode = true;
    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await AuthStorage.IsAuthenticatedAsync())
            {
                Nav.NavigateTo("/chat");
            }
        }
        catch
        {

        }
    }

    private void SetMode(bool login)
    {
        isLoginMode = login;
        errorMessage = "";
    }

    private async Task HandleSubmit()
    {
        
        errorMessage = "";
        
        var cleanEmail = email.Trim();
        var cleanPass = password.Trim();

        if (string.IsNullOrWhiteSpace(cleanEmail))
        {
            errorMessage = "Введите почту";
            return;
        }

        if (string.IsNullOrWhiteSpace(cleanPass))
        {
            errorMessage = "Введите пароль";
            return;
        }

        if (!isLoginMode && string.IsNullOrWhiteSpace(username))
        {
            errorMessage = "Укажите юзернейм";
            return;
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            name = "User_" + random.Next(1000, 9999);
        }

        isSubmitting = true;

        try
        {
            string passHash = ComputeSha256(cleanPass);

            var payload = new User
            {   
                Email = cleanEmail,
                Name = name,
                UserName = isLoginMode ? cleanEmail : username.Trim(),
                PasswordHash = passHash
            };

            string endpoint = isLoginMode ? "api/users/login" : "api/users/register";

            var response = await Http.PostAsJsonAsync(endpoint, payload);

            if (response.IsSuccessStatusCode)
            {
                var user = await response.Content.ReadFromJsonAsync<User>();

                if (user != null && user.Id > 0)
                {
                    AuthStorage.SaveUserSession(user);
                    Nav.NavigateTo("/chat");
                }
            }
            else
            {
                var serverError = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrWhiteSpace(serverError) 
                    ? serverError 
                    : (isLoginMode ? "Неверный логин или пароль" : "Ошибка регистрации");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Нет связи с сервером (http://localhost:5050): {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string ComputeSha256(string rawData)
    {
        using var sha256 = System.Security.Cryptography.SHA256.Create();
        byte[] bytes = sha256.ComputeHash(System.Text.Encoding.UTF8.GetBytes(rawData));
        var sb = new System.Text.StringBuilder();
        foreach (var b in bytes)
        {
            sb.Append(b.ToString("x2"));
        }
        return sb.ToString();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleSubmit();
        }
    }
}